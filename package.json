{
  "name": "vie",
  "version": "1.0.0",
  "description": "✅ Vérification Informatique des Équipes",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:bundle && npm run build:types",
    "build:bundle": "rolldown --config rolldown.config.mjs",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run type-check && npm run test && npm run build"
  },
  "keywords": [
    "verification",
    "teams",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "oxfmt": "^0.21.0",
    "oxlint": "^1.36.0",
    "rolldown": "^1.0.0-beta.58",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
